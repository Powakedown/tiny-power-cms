<% content_for :full_screen do %>
<div class="min-h-screen bg-gradient-to-br from-blue-600 to-purple-600 flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <!-- Logo/Branding -->
    <div class="text-center mb-10">
      <h1 class="text-5xl font-bold text-white mb-2">Tiny Power CMS</h1>
      <p class="text-blue-100 text-lg">Administrator Dashboard</p>
    </div>

    <!-- Sign In Card -->
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
      <!-- Header -->
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 px-8 py-6">
        <h2 class="text-2xl font-bold text-white">Sign In</h2>
        <p class="text-blue-100 text-sm mt-1">Enter your credentials to continue</p>
      </div>

      <!-- Form -->
      <div class="px-8 py-8">
        <%= form_with url: sessions_path, method: :post, class: "space-y-5" do |f| %>
          <!-- Email Field -->
          <div>
            <%= f.label :email, "Email Address", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.email_field :email,
                placeholder: "you@example.com",
                autofocus: true,
                required: true,
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
          </div>

          <!-- Password Field -->
          <div>
            <%= f.label :password, "Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.password_field :password,
                placeholder: "••••••••",
                required: true,
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
          </div>

          <!-- Sign In Button -->
          <div class="pt-2">
            <%= f.submit "Sign In", class: "w-full bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold py-3 rounded-lg hover:from-blue-700 hover:to-purple-700 transition duration-200 transform hover:scale-105 cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <!-- Footer -->
      <div class="bg-gray-50 px-8 py-4 border-t border-gray-100">
        <p class="text-center text-gray-600 text-sm">
          Demo credentials: <br>
          <span class="font-mono text-gray-700">admin@example.com / password</span>
        </p>
      </div>
    </div>

    <!-- Footer Text -->
    <div class="text-center mt-8">
      <p class="text-blue-100 text-sm">
        © <%= Time.current.year %> Tiny Power CMS. All rights reserved.
      </p>
    </div>
  </div>
</div>
<% end %>

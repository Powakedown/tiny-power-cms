  <div class="min-h-screen bg-gradient-to-br from-blue-600 to-purple-600 flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <!-- Sign In Card -->
      <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-purple-600 px-8 py-6">
          <h2 class="text-2xl font-bold text-white">Entrer en mode édition</h2>
        </div>

        <!-- Form -->
        <div class="px-8 py-8">
          <%= form_with url: sessions_path, method: :post, class: "space-y-5" do |f| %>
            <!-- Email Field -->
            <div>
              <%= f.label :email, "Adresse e-mail", class: "block text-sm font-semibold text-gray-700 mb-2" %>
              <%= f.email_field :email,
                  placeholder: "votre@email.com",
                  autofocus: true,
                  required: true,
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
            </div>

            <!-- Password Field -->
            <div>
              <%= f.label :password, "Mot de passe", class: "block text-sm font-semibold text-gray-700 mb-2" %>
              <%= f.password_field :password,
                  placeholder: "••••••••",
                  required: true,
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
            </div>

            <!-- Sign In Button -->
            <div class="pt-2">
              <%= f.submit "Se connecter", class: "w-full bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold py-3 rounded-lg hover:from-blue-700 hover:to-purple-700 transition duration-200 transform hover:scale-105 cursor-pointer" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Footer Text -->
      <div class="text-center mt-8">
        <p class="text-blue-100 text-sm">
          © <%= Time.current.year %> Maxime Boué. Tous droits réservés.
        </p>
      </div>
    </div>
  </div>

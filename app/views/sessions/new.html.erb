  <div class="session-page">
  <div class="session-container">
    <div class="session-card">
      <div class="session-card__header">
        <h2 class="session-card__title">Entrer en mode édition</h2>
      </div>

      <div class="session-card__body">
        <%= form_with url: sessions_path, method: :post, class: "session-form" do |f| %>
          <div class="session-form__field">
            <%= f.label :email, "Adresse e-mail", class: "session-form__label" %>
            <%= f.email_field :email,
                placeholder: "votre@email.com",
                autofocus: true,
                required: true,
                class: "session-form__input" %>
          </div>

          <div class="session-form__field">
            <%= f.label :password, "Mot de passe", class: "session-form__label" %>
            <%= f.password_field :password,
                placeholder: "••••••••",
                required: true,
                class: "session-form__input" %>
          </div>

          <%= f.submit "Se connecter", class: "session-form__submit" %>
        <% end %>
      </div>
    </div>

    <p class="session-footer">© <%= Time.current.year %> Maxime Boué. Tous droits réservés.</p>
  </div>
</div>


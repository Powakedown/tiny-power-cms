<div class="w-full">
  <div class="flex justify-between items-center mb-8">
    <h1 class="font-bold text-4xl text-gray-900">Welcome to Tiny Power CMS</h1>
    <% if user_signed_in? %>
      <div class="flex items-center gap-4">
        <div class="text-right">
          <p class="text-gray-600 text-sm">Signed in as</p>
          <p class="font-semibold text-gray-900"><%= current_user.email %></p>
        </div>
        <%= button_to "Sign Out", sessions_path, method: :delete, class: "px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition" %>
      </div>
    <% else %>
      <%= link_to "Sign In", session_path, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Welcome Card -->
    <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-8 border border-blue-200">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🚀 Getting Started</h2>
      <p class="text-blue-800 mb-4">
        Your CMS is up and running! Start building your content management system with powerful features.
      </p>
      <% if user_signed_in? %>
        <p class="text-blue-700 font-semibold">Status: ✅ Authenticated</p>
      <% else %>
        <p class="text-blue-700 font-semibold">Status: 🔒 Sign in to access admin features</p>
      <% end %>
    </div>

    <!-- Features Card -->
    <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-8 border border-purple-200">
      <h2 class="text-2xl font-bold text-purple-900 mb-4">⚡ Features</h2>
      <ul class="text-purple-800 space-y-2">
        <li class="flex items-center gap-2">
          <span class="text-lg">✓</span> User Authentication
        </li>
        <li class="flex items-center gap-2">
          <span class="text-lg">✓</span> Tailwind CSS Styling
        </li>
        <li class="flex items-center gap-2">
          <span class="text-lg">✓</span> PostgreSQL Database
        </li>
      </ul>
    </div>

    <!-- Authentication Card -->
    <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-8 border border-green-200">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🔐 Authentication</h2>
      <p class="text-green-800 mb-4">
        <% if user_signed_in? %>
          You're logged in! Visit your account or continue managing content.
        <% else %>
          Use the demo credentials to sign in and test the authentication system.
        <% end %>
      </p>
      <p class="text-sm text-green-700 font-mono">
        Email: admin@example.com<br>
        Password: password
      </p>
    </div>
  </div>
</div>

<%= turbo_stream.update "section-layouts" do %>
  <div class="layout-picker">
    <% [{ title: "Hero — centré", name: "Hero centré", helper: :layout_preview_hero },
        { title: "Texte gauche, image droite", name: "Texte · Image", helper: :layout_preview_text_image },
        { title: "Image gauche, texte droite", name: "Image · Texte", helper: :layout_preview_image_text },
        { title: "Bannière image pleine largeur", name: "Bannière", helper: :layout_preview_banner },
        { title: "3 cartes fonctionnalités", name: "3 cartes", helper: :layout_preview_three_cards },
        { title: "Citation", name: "Citation", helper: :layout_preview_quote },
        { title: "Texte large + aside", name: "Large · Aside", helper: :layout_preview_wide_aside },
        { title: "Statistiques", name: "Statistiques", helper: :layout_preview_stats },
        { title: "Grille 2×2 images", name: "Grille 2×2", helper: :layout_preview_grid_2x2 },
        { title: "FAQ", name: "FAQ", helper: :layout_preview_faq },
        { title: "Vidéo + légende", name: "Vidéo", helper: :layout_preview_video },
        { title: "Bande CTA", name: "Bande CTA", helper: :layout_preview_cta_band }].each do |layout| %>
          <%= link_to new_section_path(section: { layout: layout[:helper] }),
                data: { turbo_stream: true },
                class: "layout-card",
                title: layout[:title] do %>
            <%= send(layout[:helper]) %>
            <%= tag.span(layout[:name], class: "layout-card__label") %>
          <% end %>
    <% end %>

    <%= link_to section_layout_path,
          data: { turbo_method: :delete, turbo_stream: true },
          class: "layout-picker__collapse",
          aria: { label: "Fermer" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    <% end %>
  </div>
<% end %>
